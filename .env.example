# Local Application Environment Configuration
# Copy this file to .env and adjust local settings as needed.
# NEVER commit .env to GitHub or any version control.

# Application Server
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False

# Automation Settings
HEADLESS=False
REQUEST_TIMEOUT_SECONDS=30
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=5

# Matcher Configuration
MIN_MATCH_SCORE=65
TARGET_MIN_EXPERIENCE_YEARS=0
TARGET_MAX_EXPERIENCE_YEARS=2.5

# Posting Date Filter (only consider jobs posted within last 3-4 days)
MAX_POSTING_AGE_DAYS=4

# Retention & Storage Policy (clean up temporary / outdated manual records after 5-6 days)
CLEANUP_RETENTION_DAYS=6
LOG_RETENTION_DAYS=7
DB_PATH=data/applications.db
RESUME_PATH=data/resume.pdf
PROFILE_PATH=data/profile.json

# Optional Local Portal Credentials (stored locally only, NEVER committed)
PORTAL_EMAIL=your_email@example.com
PORTAL_PASSWORD=your_password
